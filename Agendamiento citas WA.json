    {
      "parameters": {
        "jsCode": "const citas = $items().map(item => item.json);\nconst ahora = DateTime.now();\nconst citasFuturas = citas.filter(cita => {\n  const fechaCita = DateTime.fromISO(cita['Fecha ISO']);\n  return fechaCita > ahora;\n});\nif (citasFuturas.length === 0) {\n  const nombreCliente = citas[0]?.['Nombre Cliente'] || '';\n  return { message: `Hola, ${nombreCliente}. 👋 Tienes citas registradas pero ninguna próxima.` };\n}\nconst nombreCliente = citasFuturas[0]['Nombre Cliente'];\nlet mensaje = `¡Hola, ${nombreCliente}! 👋 Tus próximas citas:\\n\\n`;\nfor (const cita of citasFuturas) {\n  mensaje += `🗓️ ${cita['Fecha y hora']}\\n`;\n}\nreturn { message: mensaje };"
      },
