        "remoteJid": "={{ $('data_citas').item.json.chatId }}",
        "messageText": "=¡Hola! 👋 Bienvenido/a al Asistente Virtual de Citas.\n\n*🗓️ Agendar una cita:*\n`agendar AAAA-MM-DD HH:MM Tu Nombre Completo`\n_Ejemplo: agendar 2025-09-22 15:00 Ana Rodriguez_\n\n*❌ Cancelar una cita:*\n`cancelar AAAA-MM-DD HH:MM Tu Nombre Completo`\n\n*📋 Ver tus citas:*\n`citas Tu Nombre Completo`\n\nAtendemos *lunes a viernes 07:00-19:00* y *sábados 07:00-13:00*.",
        "options_message": {}
      },
      "id": "wa005-0000-0000-0000-000000000005",
      "name": "Respuesta Bienvenida",
      "type": "n8n-nodes-evolution-api.evolutionApi",
      "typeVersion": 1,
      "position": [400, -160],
      "credentials": { "evolutionApi": { "id": "6aCgScDhYrgRt176", "name": "Evolution account" } }
    },
    {
      "parameters": {
        "jsCode": "const text = $input.first().json.messageText.trim();\nconst parts = text.split(/\\s+/);\nif (parts.length < 4) {\n  return { valid: false, error: \"Faltan datos\\\\. Usa el formato exacto:\\\\n`agendar AAAA\\\\-MM\\\\-DD HH:MM Tu Nombre`\\\\n\\\\nEjemplo:\\\\n`agendar 2025\\\\-09\\\\-22 15:00 Ana García`\" };\n}\nconst date = parts[1];\nconst time = parts[2];\nconst name = parts.slice(3).join(' ').trim();\nconst dateRegex = /^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$/;\nif (!dateRegex.test(date)) {\n  return { valid: false, error: `La fecha *${date}* no es válida\\\\.\\nUsa el formato: \\`AAAA\\\\-MM\\\\-DD\\`\\nEjemplo: \\`2025\\\\-09\\\\-22\\`` };\n}\nconst timeRegex = /^([01]\\d|2[0-3]):[0-5]\\d$/;\nif (!timeRegex.test(time)) {\n  return { valid: false, error: `La hora *${time}* no es válida\\\\.\\nUsa formato 24h: \\`HH:MM\\`\\nEjemplo: \\`15:00\\`` };\n}\nconst zone = 'America/Guayaquil';\nconst startDateTime = DateTime.fromFormat(`${date} ${time}`, 'yyyy-MM-dd HH:mm', { zone });\nif (!startDateTime.isValid) {\n  return { valid: false, error: `La fecha *${date}* no existe en el calendario\\\\. Verifica el día del mes\\\\.` };\n}\nif (startDateTime < DateTime.now().setZone(zone)) {\n  return { valid: false, error: `La fecha *${date} ${time}* ya pasó\\\\. Por favor elige una fecha y hora futura\\\\.` };\n}\nconst weekday = startDateTime.weekday;\nconst hour = startDateTime.hour;\nconst minute = startDateTime.minute;\nconst timeInMin = hour * 60 + minute;\nif (weekday === 7) {\n  return { valid: false, error: \"No atendemos los *domingos*\\\\. Elige un día de lunes a sábado\\\\.\" };\n}\nif (weekday === 6 && timeInMin > 13*60) {\n  return { valid: false, error: \"Los sábados atendemos hasta las *13:00*\\\\. Elige otro horario\\\\.\" };\n}\nif (timeInMin < 7*60 || timeInMin > 19*60) {\n  return { valid: false, error: \"Horario de atención: *lunes a viernes 07:00\\\\-19:00*, *sábados 07:00\\\\-13:00*\\\\.\" };\n}\nif (!name || name.split(' ').filter(w => w.length > 0).length < 2) {\n  return { valid: false, error: \"Por favor escribe tu *nombre y apellido completos*\\\\.\\nEjemplo: `agendar 2025\\\\-09\\\\-22 15:00 Ana García`\" };\n}\nif (/\\d/.test(name)) {\n  return { valid: false, error: \"El nombre no debe contener números\\\\. Escribe tu nombre completo\\\\.\" };\n}\nconst endDateTime = startDateTime.plus({ hours: 1 });\nreturn { valid: true, date, time, name, startDateTime: startDateTime.toISO(), endDateTime: endDateTime.toISO(), summary: `Cita para ${name} - Bot CIAP` };"
      },
