    {
      "parameters": {
        "jsCode": "const text = $input.first().json.messageText.trim();\nconst parts = text.split(/\\s+/);\nif (parts.length < 4) {\n  return { valid: false, error: \"Faltan datos\\\\. Usa el formato:\\\\n`cancelar AAAA\\\\-MM\\\\-DD HH:MM Tu Nombre`\\\\n\\\\nEjemplo:\\\\n`cancelar 2025\\\\-09\\\\-22 15:00 Ana García`\" };\n}\nconst date = parts[1];\nconst time = parts[2];\nconst name = parts.slice(3).join(' ').trim();\nconst dateRegex = /^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$/;\nif (!dateRegex.test(date)) {\n  return { valid: false, error: `La fecha *${date}* no es válida\\\\. Usa: \\`AAAA\\\\-MM\\\\-DD\\`` };\n}\nconst timeRegex = /^([01]\\d|2[0-3]):[0-5]\\d$/;\nif (!timeRegex.test(time)) {\n  return { valid: false, error: `La hora *${time}* no es válida\\\\. Usa formato 24h: \\`HH:MM\\`` };\n}\nconst zone = 'America/Guayaquil';\nconst startDateTime = DateTime.fromFormat(`${date} ${time}`, 'yyyy-MM-dd HH:mm', { zone });\nif (!startDateTime.isValid) {\n  return { valid: false, error: `La fecha *${date}* no existe en el calendario\\\\.` };\n}\nconst oneYearAgo = DateTime.now().setZone(zone).minus({ years: 1 });\nif (startDateTime < oneYearAgo) {\n  return { valid: false, error: \"La fecha indicada es demasiado antigua\\\\. Solo puedes cancelar citas del último año\\\\.\" };\n}\nif (!name || name.split(' ').filter(w => w.length > 0).length < 2) {\n  return { valid: false, error: \"Escribe tu *nombre y apellido completos* como los registraste al agendar\\\\.\" };\n}\nif (/\\d/.test(name)) {\n  return { valid: false, error: \"El nombre no debe contener números\\\\.\" };\n}\nconst endDateTime = startDateTime.plus({ hours: 1 });\nreturn { valid: true, date, time, name, startDateTime: startDateTime.toISO(), endDateTime: endDateTime.toISO(), summary: `Cita para ${name}` };"
