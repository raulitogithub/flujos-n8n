    {
      "parameters": {
        "jsCode": "const text = $input.first().json.messageText.trim();\nconst parts = text.split(/\\s+/);\nif (parts.length < 2) {\n  return { valid: false, error: \"Escribe tu nombre después del comando\\\\.\\nEjemplo: `citas Ana García`\" };\n}\nconst name = parts.slice(1).join(' ').trim();\nif (name.split(' ').filter(w => w.length > 0).length < 2) {\n  return { valid: false, error: \"Escribe tu *nombre y apellido completos* para buscar tus citas\\\\.\\nEjemplo: `citas Ana García`\" };\n}\nif (/\\d/.test(name)) {\n  return { valid: false, error: \"El nombre no debe contener números\\\\. Escribe tu nombre completo\\\\.\" };\n}\nconst words = name.split(' ').filter(w => w.length > 0);\nif (words.some(w => w.length < 2)) {\n  return { valid: false, error: \"Cada parte del nombre debe tener al menos 2 letras\\\\. Escribe tu nombre completo\\\\.\" };\n}\nreturn { valid: true, name };"
      },
