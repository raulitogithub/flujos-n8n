      "id": "wa015-0000-0000-0000-000000000015",
      "name": "Get eventos del dia",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [1640, 560],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const zone = 'America/Guayaquil';\nconst requestedISO = $('Preparar Agendar').item.json.startDateTime;\nconst requestedDT = DateTime.fromISO(requestedISO, { zone });\nconst date = requestedDT.toFormat('yyyy-MM-dd');\nconst weekday = requestedDT.weekday;\nconst startHour = 7;\nconst endHour = weekday === 6 ? 13 : 19;\nconst now = DateTime.now().setZone(zone);\nconst events = $items().map(i => i.json).filter(e => e.id);\nconst slots = [];\nfor (let h = startHour; h < endHour; h++) {\n  const slotStart = DateTime.fromFormat(`${date} ${String(h).padStart(2,'0')}:00`, 'yyyy-MM-dd HH:mm', { zone });\n  const slotEnd = slotStart.plus({ hours: 1 });\n  if (slotEnd <= now) continue;\n  const occupied = events.some(ev => {\n    const evStart = DateTime.fromISO(ev.start?.dateTime || ev.start?.date, { zone });\n    const evEnd = DateTime.fromISO(ev.end?.dateTime || ev.end?.date, { zone });\n    return slotStart < evEnd && slotEnd > evStart;\n  });\n  if (!occupied) slots.push(slotStart.toFormat('HH:mm'));\n}\nif (slots.length === 0) {\n  return { message: `😔 Lo siento, el día *${date}* no tiene más horarios disponibles.\\n\\nPor favor elige otro día y envía:\\n\\`agendar AAAA-MM-DD HH:MM Tu Nombre\\`` };\n}\nconst slotsText = slots.map(s => `• ${s}`).join('\\n');\nreturn { message: `⏰ Ese horario está ocupado.\\n\\n📅 Horarios libres para el *${date}*:\\n\\n${slotsText}\\n\\nResponde con:\\n\\`agendar ${date} HH:MM Tu Nombre\\`` };"
      },
