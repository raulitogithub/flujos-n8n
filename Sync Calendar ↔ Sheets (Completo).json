      "parameters": {
        "jsCode": "const evt = $input.first().json;\nconst summary = evt.summary || '';\nconst name = summary.replace(/^Cita:\\s*/i, '').trim();\nconst zone = 'America/Guayaquil';\nconst startDT = evt.start?.dateTime || evt.start?.date || '';\nconst fechaFormatted = startDT\n  ? DateTime.fromISO(startDT).setZone(zone).setLocale('es').toFormat(\"cccc, dd 'de' MMMM 'de' yyyy 'a las' HH:mm\")\n  : '';\n\nreturn {\n  id: evt.id,\n  \"Fecha ISO\": startDT,\n  \"Fecha y hora\": fechaFormatted,\n  \"Nombre Cliente\": name\n};"
      },
